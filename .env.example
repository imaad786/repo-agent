# Application Configuration
HOST=0.0.0.0
PORT=8080
WORKERS=1

# CORS Configuration
# Use "*" for all origins (development only) or provide comma-separated list
# Example: https://example.com,https://api.example.com
CORS_ALLOWED_ORIGINS=*

# Database Configuration
# Format: postgresql+psycopg://username:password@host:port/database
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/your_database
DATABASE_SCHEMA=public
JOB_STORE_DATABASE_SCHEMA=public_job_store

# Event Polling Configuration
SAMPLE_EVENT_POLLING_BACKOFF_INITIAL_IN_SECONDS=5
SAMPLE_EVENT_POLLING_BACKOFF_MAX_IN_SECONDS=30

# Job Scheduler Configuration
# Cron format: minute hour day month day_of_week
SAMPLE_JOB_FREQUENCY="0 * * * *"

# MCP Server Configuration
# Base URL for the MCP server
MCP_SERVER_URL=http://0.0.0.0:8080/mcp

# MCP prompt name to fetch system instructions
MCP_PROMPT_NAME=code_intelligence_assistant

# MCP request timeout in seconds
MCP_TIMEOUT=30

# LLM API Keys Configuration
# Provide API keys for the LLM providers you plan to use
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Agent Configuration
# Maximum recursion depth for agent tool calls
AGENT_RECURSION_LIMIT=20

# Maximum number of messages to keep in short-term memory
AGENT_MEMORY_LIMIT=100

# Maximum number of tokens in conversation history
AGENT_TOKEN_LIMIT=100000

